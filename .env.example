# ---- LLM (OpenAI-compatible endpoint; default = local vLLM on the GPU) ----
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# To use a hosted API instead, e.g.:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---- Retrieval models (run on the GPU) ----
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=models/scholar-rerank
DEVICE=cuda

# ---- Stores ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
DATABASE_URL=sqlite:///storage/scholar.db

# ---- Academic APIs (all optional) ----
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Identifies you to the polite pools of Crossref/OpenAlex. Leave empty to stay anonymous.
CONTACT_EMAIL=

# Retrieval fusion (relative score fusion beat RRF on the DEV split) - weights are (dense, bm25)
FUSION=rsf
FUSION_WEIGHTS=0.4,0.6

# Batch sizes are small on purpose: the local LLM server shares the GPU
EMBED_BATCH=16
RERANK_BATCH=8
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
